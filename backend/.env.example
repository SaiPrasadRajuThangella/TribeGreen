# Copy to .env and fill in. `npm run dev` works without MONGODB_URI: it starts a local
# MongoDB in backend/.data. Set MONGODB_URI (e.g. a MongoDB Atlas string) to use a real one.
PORT=4000
MONGODB_URI=

# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Website address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8081

# The one admin account, created on first start (password stored hashed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tribegreen

# Customer sign-in codes. No SMS provider yet:
#   fixed   = every number uses FIXED_OTP (demo)
#   console = a random code is printed in the server log
OTP_MODE=fixed
FIXED_OTP=123456

# Hours the sales team has to call back after an enquiry
REPLY_WITHIN_HOURS=2

# Fill an empty database with sample enquiries for the admin page
SEED_SAMPLES=true
