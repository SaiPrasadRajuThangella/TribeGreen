# Address of the backend API. Leave empty in development: Vite forwards /api to
# http://localhost:4000 (start it with `cd backend && npm run dev`).
# In production set it to the deployed API, e.g. https://tribe-green-api.onrender.com
VITE_API_URL=
VITE_WHATSAPP_NUMBER=919876543210
# Public URL of the deployed site, used for share links and og:url
VITE_SITE_URL=https://tribegreen.vercel.app
